root = true

[*]
charset = utf-8
end_of_line = lf
# 4 for PHP-leaning repositories, 2 for JS/TS/Go. Set it once, here, to
# whatever this repository's primary language uses — the per-type overrides below
# then only cover the exceptions.
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing whitespace is significant in Markdown (a hard line break), so trimming
# it silently changes rendered output.
#
# indent_size is pinned here rather than inherited from [*], because there is no
# prettier config to shadow it: prettier reads .editorconfig and maps indent_size to
# tabWidth. Without this, a repository that sets [*] to 4 for its primary language
# would silently get its Markdown lists reindented to 4 as well.
[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.php]
indent_size = 4

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab
