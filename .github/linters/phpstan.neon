# PHPStan configuration.
#
# Paths are relative to THIS file (.github/linters/), which is why they climb two
# levels. That is the convention the shared workflows expect — they invoke the
# analyser through the repository's own script (`composer phpstan`), so the config
# path is fixed even though the working directory is the repository root.
#
# Level 9 is the team standard: everything short of level 10's treatment of `mixed`.
# Lower it only with a reason recorded in CLAUDE.md, and treat that as temporary.
parameters:
    level: 9
    fileExtensions:
        - php
    paths:
        - ../../src
        - ../../tests
    # Analyse tests as well as source, and keep it that way: a test that no longer
    # type-checks is usually a test that no longer tests what it claims.
    excludePaths:
        - ../../vendor
        - ../../build
        - ../../node_modules
